# ==========================================
# TrackDaily Environment Configuration Template
# Copy this to .env.local for local development.
# Configure these variables in Netlify Dashboard (Site configuration > Environment variables) for production.
# ==========================================

# Database: MongoDB connection URI
# Local: mongodb://127.0.0.1:27017
# Production (Netlify): mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=trakloop

# Authentication Secrets (minimum 32 characters each)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your-cryptographically-secure-secret-key-min-32-chars
SESSION_SECRET=your-session-secret-key-min-32-chars

# Application URL used for CSRF origin validation
# Local: http://localhost:3000
# Production: https://your-site.netlify.app
APP_URL=http://localhost:3000

# SMS Provider Configuration
# Options: console, twilio, webhook
# In production on Netlify, use 'twilio' or 'webhook'.
# To test in Netlify without Twilio, set SMS_PROVIDER=console and ALLOW_CONSOLE_SMS=true (OTPs will appear in Netlify Function logs).
SMS_PROVIDER=console
ALLOW_CONSOLE_SMS=false

# Webhook SMS provider (required when SMS_PROVIDER=webhook)
SMS_API_KEY=
SMS_SENDER_ID=
SMS_WEBHOOK_URL=

# Twilio SMS provider (required when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Deployment environment (development / production)
NODE_ENV=development
